# The app is one file. A phone that caches it never sees a new version — Phil sat two builds
# behind for a day. Always revalidate the shell; let the artwork cache hard.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/version.txt
  Cache-Control: no-cache, must-revalidate
/sw.js
  Cache-Control: no-cache, must-revalidate
/c/index.html
  Cache-Control: no-cache, must-revalidate
/steam/*
  Cache-Control: public, max-age=604800
