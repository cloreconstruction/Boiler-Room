# The app is one file. A phone that caches it never sees a new version — Phil sat two builds
# behind for a day. Always revalidate the shell; let the artwork cache hard.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/version.txt
  Cache-Control: no-cache, must-revalidate
/sw.js
  Cache-Control: no-cache, must-revalidate
/c/index.html
  Cache-Control: no-cache, must-revalidate
/steam/*
  Cache-Control: public, max-age=604800

# 🔒 v6.26 — belt and braces with the 404s in netlify.toml: keep these out of search
# results too, in case a rule is ever loosened.
/CLAUDE.md
  X-Robots-Tag: noindex, nofollow
/tests/*
  X-Robots-Tag: noindex, nofollow
/fnsrc/*
  X-Robots-Tag: noindex, nofollow
